{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5041",
  "ConnectionStrings": {
    "DefaultConnection": "User ID=lab_user;Password=lab_pass;Database=lab_netmicro_pricing;Host=localhost;Port=5432"
  },
  "Spring": {
    "Application": {
      "Name": "PricingService"
    }
  },
  "Eureka": {
    "Client": {
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": true,
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ValidateCertificates": false
    },
    "Instance": {
      "AppName": "PricingService",
      "Port": 5041,
      "HostName": "localhost",
      "PreferIpAddress": false,
      "HealthCheckUrlPath": "/health",
      "StatusPageUrlPath": "/info"
    }
  }
}
